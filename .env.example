# Copy to .env and change what you need. Every value is optional.

# Express API port.
PORT=3001

# React app origins allowed by CORS (comma-separated).
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173

# MongoDB connection string (local install or Atlas). Leave unset to use the embedded
# MongoDB, which saves to .data/mongo.
# MONGODB_URI=mongodb://localhost:27017/reading-game

# Where the embedded MongoDB keeps its files (only used without MONGODB_URI).
# MONGODB_DATA_DIR=.data/mongo

# Where the React app finds the API (read by Vite at build/dev time).
VITE_API_URL=http://localhost:3001

# Send the session cookie over HTTPS only (on automatically when NODE_ENV=production).
# COOKIE_SECURE=true
